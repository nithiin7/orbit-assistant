# Docker Compose settings (compose.yaml). Copy to `.env` beside compose.yaml. Never commit it.
# For local development without Docker, use apps/web/.env.example and apps/api/.env.example.
# Guide: docs/deployment.md

# --- Addresses ---------------------------------------------------------------------------

# Where browsers reach the web app and the API. PUBLIC_API_URL is built into the web bundle,
# so rebuild (`docker compose up -d --build`) after changing it. It is public.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Host address and ports to publish. 127.0.0.1 keeps Orbit reachable only from this machine;
# use 0.0.0.0 to expose it on your network (prefer the HTTPS proxy for anything beyond that).
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000

# With `docker compose --profile proxy`, Caddy serves both apps over HTTPS on this domain.
# Then set PUBLIC_WEB_URL and PUBLIC_API_URL to https://<DOMAIN>.
# DOMAIN=orbit.example.com

# Images to run. Defaults build from source; to use published images instead, set for example
# ORBIT_API_IMAGE=ghcr.io/OWNER/orbit-api:latest and run `docker compose up -d --no-build`.
# The published web image is built for http://localhost:8000; other API URLs need a build.
# ORBIT_API_IMAGE=orbit-api:local
# ORBIT_WEB_IMAGE=orbit-web:local

# --- API settings ------------------------------------------------------------------------
# Any ORBIT_* variable from apps/api/.env.example can go here. The image already sets
# ORBIT_ENV=production and keeps the database and files in the `orbit-data` volume.

# ORBIT_LOG_LEVEL=info

# Local mode (default): only the first account can register in production. Set to true to let
# others on this server create their own accounts.
# ORBIT_LOCAL_OPEN_REGISTRATION=false

# Cloud mode: PostgreSQL on Supabase. `docker compose up` migrates this database.
# ORBIT_STORAGE_MODE=cloud
# ORBIT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?ssl=require
# ORBIT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# ORBIT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI: a Fernet key that encrypts stored provider API keys. Required in cloud mode to store keys;
# in local mode a key file is generated in the data volume. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ORBIT_AI_SECRET_KEY=
# Integrations (docs/integrations.md): OAuth apps you create with Google and Microsoft. The
# redirect URI registered with them, and set here, is PUBLIC_WEB_URL + /integrations/callback.
# ORBIT_GOOGLE_CLIENT_ID=
# ORBIT_GOOGLE_CLIENT_SECRET=
# ORBIT_MICROSOFT_CLIENT_ID=
# ORBIT_MICROSOFT_CLIENT_SECRET=
# ORBIT_INTEGRATIONS_REDIRECT_URL=https://orbit.example.com/integrations/callback
# Encrypts account tokens; required in cloud mode (generate like the AI key above).
# ORBIT_INTEGRATIONS_SECRET_KEY=
# With the HTTPS proxy: providers push calendar changes here instead of being polled.
# ORBIT_INTEGRATIONS_WEBHOOK_URL=https://orbit.example.com/api/v1/integrations/webhooks
# Ollama running on the Docker host is reachable at http://host.docker.internal:11434 (Docker
# Desktop; on Linux add `extra_hosts: ["host.docker.internal:host-gateway"]` to the api service).
