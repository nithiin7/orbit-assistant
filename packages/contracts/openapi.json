{
  "openapi": "3.1.0",
  "info": {
    "title": "Orbit API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check API health",
        "description": "Return a minimal status payload. Contains no configuration or secrets.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/database": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check database connectivity",
        "description": "Query the database. Reports the storage mode, never paths or connection details.",
        "operationId": "database_health_api_v1_health_database_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable."
          }
        }
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get sign-in configuration",
        "description": "How the web app should sign users in. Public, and contains no secrets.",
        "operationId": "auth_config_api_v1_auth_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LocalAuthConfig"
                    },
                    {
                      "$ref": "#/components/schemas/SupabaseAuthConfig"
                    }
                  ],
                  "title": "Response Auth Config Api V1 Auth Config Get",
                  "discriminator": {
                    "propertyName": "provider",
                    "mapping": {
                      "local": "#/components/schemas/LocalAuthConfig",
                      "supabase": "#/components/schemas/SupabaseAuthConfig"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-up": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create a local account",
        "description": "Create an account and its Personal workspace, and sign it in.",
        "operationId": "sign_up_api_v1_auth_local_sign_up_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalSignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalSessionResponse"
                }
              }
            }
          },
          "403": {
            "description": "This installation does not accept new accounts."
          },
          "409": {
            "description": "An account with this email already exists."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in to a local account",
        "operationId": "sign_in_api_v1_auth_local_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is incorrect."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current local session",
        "description": "Revoke the session token used for this request.",
        "operationId": "sign_out_api_v1_auth_local_sign_out_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Get the signed-in user's profile",
        "description": "In cloud mode, the first call for a new Supabase user creates the profile and its\nPersonal workspace.",
        "operationId": "get_profile_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "account"
        ],
        "summary": "Update the signed-in user's profile",
        "operationId": "update_profile_api_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "List workspaces",
        "operationId": "list_workspaces_api_v1_workspaces_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "workspaces"
        ],
        "summary": "Create a workspace",
        "description": "Create a private workspace owned by the signed-in user.",
        "operationId": "create_workspace_api_v1_workspaces_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Get a workspace",
        "operationId": "get_workspace_api_v1_workspaces__workspace_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "The workspace does not exist or is not accessible."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "workspaces"
        ],
        "summary": "Rename a workspace",
        "operationId": "update_workspace_api_v1_workspaces__workspace_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "The workspace does not exist or is not accessible."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWorkspaceRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateWorkspaceRequest"
      },
      "DatabaseHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Always `ok` when the database answered a query."
          },
          "storage_mode": {
            "type": "string",
            "enum": [
              "local",
              "cloud"
            ],
            "title": "Storage Mode",
            "description": "`local` (SQLite on this machine) or `cloud` (hosted PostgreSQL)."
          }
        },
        "type": "object",
        "required": [
          "status",
          "storage_mode"
        ],
        "title": "DatabaseHealthResponse",
        "description": "Reports that the configured database is reachable."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Always `ok` when the API is serving requests."
          },
          "service": {
            "type": "string",
            "const": "orbit-api",
            "title": "Service",
            "description": "Name of the responding service."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version of the running API."
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Reports that the API process is running and able to serve requests."
      },
      "LocalAuthConfig": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "local",
            "title": "Provider"
          },
          "registration_open": {
            "type": "boolean",
            "title": "Registration Open",
            "description": "Whether a new local account can be created."
          }
        },
        "type": "object",
        "required": [
          "provider",
          "registration_open"
        ],
        "title": "LocalAuthConfig"
      },
      "LocalSessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Send as `Authorization: Bearer <token>`."
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "user"
        ],
        "title": "LocalSessionResponse"
      },
      "LocalSignInRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LocalSignInRequest"
      },
      "LocalSignUpRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "LocalSignUpRequest"
      },
      "SupabaseAuthConfig": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "supabase",
            "title": "Provider"
          },
          "supabase_url": {
            "type": "string",
            "title": "Supabase Url"
          },
          "supabase_publishable_key": {
            "type": "string",
            "title": "Supabase Publishable Key"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "supabase_url",
          "supabase_publishable_key"
        ],
        "title": "SupabaseAuthConfig",
        "description": "Public Supabase settings the web app needs to sign users in. Contains no secrets."
      },
      "UpdateProfileRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "UpdateProfileRequest"
      },
      "UpdateWorkspaceRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "UpdateWorkspaceRequest"
      },
      "UserProfile": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "auth_provider": {
            "type": "string",
            "enum": [
              "local",
              "supabase"
            ],
            "title": "Auth Provider",
            "description": "`local` (an account on this installation) or `supabase` (Supabase Auth)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "auth_provider",
          "created_at"
        ],
        "title": "UserProfile",
        "description": "The signed-in user's profile."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceListResponse": {
        "properties": {
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceResponse"
            },
            "type": "array",
            "title": "Workspaces",
            "description": "Workspaces the user can access, the personal workspace first."
          }
        },
        "type": "object",
        "required": [
          "workspaces"
        ],
        "title": "WorkspaceListResponse"
      },
      "WorkspaceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "is_personal": {
            "type": "boolean",
            "title": "Is Personal",
            "description": "The default workspace created with the account."
          },
          "role": {
            "type": "string",
            "const": "owner",
            "title": "Role",
            "description": "The signed-in user's role in the workspace."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "is_personal",
          "role",
          "created_at",
          "updated_at"
        ],
        "title": "WorkspaceResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "A local session token (local mode) or a Supabase access token (cloud mode).",
        "scheme": "bearer"
      }
    }
  }
}
