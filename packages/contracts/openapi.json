{
  "openapi": "3.1.0",
  "info": {
    "title": "Orbit API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check API health",
        "description": "Return a minimal status payload. Contains no configuration or secrets.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/database": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check database connectivity",
        "description": "Query the database. Reports the storage mode, never paths or connection details.",
        "operationId": "database_health_api_v1_health_database_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable."
          }
        }
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get sign-in configuration",
        "description": "How the web app should sign users in. Public, and contains no secrets.",
        "operationId": "auth_config_api_v1_auth_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LocalAuthConfig"
                    },
                    {
                      "$ref": "#/components/schemas/SupabaseAuthConfig"
                    }
                  ],
                  "title": "Response Auth Config Api V1 Auth Config Get",
                  "discriminator": {
                    "propertyName": "provider",
                    "mapping": {
                      "local": "#/components/schemas/LocalAuthConfig",
                      "supabase": "#/components/schemas/SupabaseAuthConfig"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-up": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create a local account",
        "description": "Create an account and its Personal workspace, and sign it in.",
        "operationId": "sign_up_api_v1_auth_local_sign_up_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalSignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalSessionResponse"
                }
              }
            }
          },
          "403": {
            "description": "This installation does not accept new accounts."
          },
          "409": {
            "description": "An account with this email already exists."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in to a local account",
        "operationId": "sign_in_api_v1_auth_local_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is incorrect."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/local/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current local session",
        "description": "Revoke the session token used for this request.",
        "operationId": "sign_out_api_v1_auth_local_sign_out_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Get the signed-in user's profile",
        "description": "In cloud mode, the first call for a new Supabase user creates the profile and its\nPersonal workspace.",
        "operationId": "get_profile_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "account"
        ],
        "summary": "Update the signed-in user's profile",
        "operationId": "update_profile_api_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me/avatar": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Get the signed-in user's profile photo",
        "operationId": "get_avatar_api_v1_me_avatar_get",
        "responses": {
          "200": {
            "description": "The photo.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "204": {
            "description": "No photo is set."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "account"
        ],
        "summary": "Set the signed-in user's profile photo",
        "description": "The request body is the image itself. Its format is detected from the file, not from\nthe declared content type.",
        "operationId": "put_avatar_api_v1_me_avatar_put",
        "requestBody": {
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          },
          "413": {
            "description": "The image is larger than 512 KB."
          },
          "415": {
            "description": "The image is not a PNG, JPEG, or WebP file."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Remove the signed-in user's profile photo",
        "operationId": "delete_avatar_api_v1_me_avatar_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "List workspaces",
        "operationId": "list_workspaces_api_v1_workspaces_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "workspaces"
        ],
        "summary": "Create a workspace",
        "description": "Create a private workspace owned by the signed-in user.",
        "operationId": "create_workspace_api_v1_workspaces_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Get a workspace",
        "operationId": "get_workspace_api_v1_workspaces__workspace_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "The workspace does not exist or is not accessible."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "workspaces"
        ],
        "summary": "Rename a workspace",
        "operationId": "update_workspace_api_v1_workspaces__workspace_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "The workspace does not exist or is not accessible."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Delete a workspace",
        "description": "Permanently delete a workspace and everything in it.",
        "operationId": "delete_workspace_api_v1_workspaces__workspace_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "The workspace does not exist or is not accessible."
          },
          "409": {
            "description": "The personal workspace cannot be deleted."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage": {
      "get": {
        "tags": [
          "storage"
        ],
        "summary": "Get the storage location",
        "operationId": "get_storage_location_api_v1_storage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageLocationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/storage/reveal": {
      "post": {
        "tags": [
          "storage"
        ],
        "summary": "Show the database in the file manager",
        "description": "Opens Finder, File Explorer, or the desktop file manager on the machine running the API,\nwhich in local mode is the user's own computer. Sync, so the spawn runs off the event loop.",
        "operationId": "reveal_storage_location_api_v1_storage_reveal_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in."
          },
          "404": {
            "description": "Not available in cloud mode or in production."
          },
          "503": {
            "description": "No file manager could be opened on the API's machine."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWorkspaceRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateWorkspaceRequest"
      },
      "DatabaseHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Always `ok` when the database answered a query."
          },
          "storage_mode": {
            "type": "string",
            "enum": [
              "local",
              "cloud"
            ],
            "title": "Storage Mode",
            "description": "`local` (SQLite on this machine) or `cloud` (hosted PostgreSQL)."
          }
        },
        "type": "object",
        "required": [
          "status",
          "storage_mode"
        ],
        "title": "DatabaseHealthResponse",
        "description": "Reports that the configured database is reachable."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Always `ok` when the API is serving requests."
          },
          "service": {
            "type": "string",
            "const": "orbit-api",
            "title": "Service",
            "description": "Name of the responding service."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version of the running API."
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Reports that the API process is running and able to serve requests."
      },
      "LocalAuthConfig": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "local",
            "title": "Provider"
          },
          "registration_open": {
            "type": "boolean",
            "title": "Registration Open",
            "description": "Whether a new local account can be created."
          }
        },
        "type": "object",
        "required": [
          "provider",
          "registration_open"
        ],
        "title": "LocalAuthConfig"
      },
      "LocalSessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Send as `Authorization: Bearer <token>`."
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "user"
        ],
        "title": "LocalSessionResponse"
      },
      "LocalSignInRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LocalSignInRequest"
      },
      "LocalSignUpRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "LocalSignUpRequest"
      },
      "StorageLocationResponse": {
        "properties": {
          "storage_mode": {
            "type": "string",
            "enum": [
              "local",
              "cloud"
            ],
            "title": "Storage Mode"
          },
          "database_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database Path",
            "description": "The SQLite file on the API's machine. Only in local mode, outside production."
          },
          "can_reveal": {
            "type": "boolean",
            "title": "Can Reveal",
            "description": "Whether the API can open the database's folder in the file manager."
          }
        },
        "type": "object",
        "required": [
          "storage_mode",
          "database_path",
          "can_reveal"
        ],
        "title": "StorageLocationResponse",
        "description": "Where this installation keeps its data, for signed-in users."
      },
      "SupabaseAuthConfig": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "supabase",
            "title": "Provider"
          },
          "supabase_url": {
            "type": "string",
            "title": "Supabase Url"
          },
          "supabase_publishable_key": {
            "type": "string",
            "title": "Supabase Publishable Key"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "supabase_url",
          "supabase_publishable_key"
        ],
        "title": "SupabaseAuthConfig",
        "description": "Public Supabase settings the web app needs to sign users in. Contains no secrets."
      },
      "UpdateProfileRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "UpdateProfileRequest"
      },
      "UpdateWorkspaceRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "UpdateWorkspaceRequest"
      },
      "UserProfile": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "auth_provider": {
            "type": "string",
            "enum": [
              "local",
              "supabase"
            ],
            "title": "Auth Provider",
            "description": "`local` (an account on this installation) or `supabase` (Supabase Auth)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "auth_provider",
          "created_at"
        ],
        "title": "UserProfile",
        "description": "The signed-in user's profile."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
