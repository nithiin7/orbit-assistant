# Normalize line endings to LF in the repository
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.{cmd,bat,ps1} text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Collapse lockfiles in diffs
pnpm-lock.yaml linguist-generated=true -diff
uv.lock linguist-generated=true -diff
packages/contracts/openapi.json linguist-generated=true
packages/contracts/src/schema.ts linguist-generated=true
