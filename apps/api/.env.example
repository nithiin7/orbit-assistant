# Copy to apps/api/.env for local overrides. Never commit real values.
# All variables are server-only and are never sent to the browser.

# One of: development, test, production. Production enables stricter validation.
ORBIT_ENV=development

# Address the API binds to. Use 0.0.0.0 only when you need access from other devices.
ORBIT_API_HOST=127.0.0.1
ORBIT_API_PORT=8000

# One of: critical, error, warning, info, debug.
ORBIT_LOG_LEVEL=info
# text (default) or json: one JSON object per line, for log collectors. Either way, each line
# carries the request ID returned in the X-Request-ID header, and query strings are never logged.
# ORBIT_LOG_FORMAT=text

# Behind a reverse proxy: the proxy addresses whose X-Forwarded-For header names the real client
# (comma-separated, or * to trust any). Sign-in limits count attempts per client address, so
# without this every request seems to come from the proxy. Unset trusts only 127.0.0.1.
# ORBIT_FORWARDED_ALLOW_IPS=

# Origins allowed to call the API from a browser, as a JSON list.
# Wildcards are rejected in production.
ORBIT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Where application data is stored. One of:
#   local  SQLite file on this machine (default)
#   cloud  hosted PostgreSQL (for example Supabase), via ORBIT_DATABASE_URL
# There is no fallback: if the selected database is unavailable, the API refuses to start.
ORBIT_STORAGE_MODE=local

# Local mode: path to the SQLite file. Defaults to apps/api/.data/orbit.sqlite3 (git-ignored).
# Keep it outside the web app and any synced or shared folder you don't trust.
# ORBIT_SQLITE_PATH=~/.local/share/orbit/orbit.sqlite3

# Cloud mode only: server-side PostgreSQL connection string. Never expose it to the browser.
# Production requires TLS (?ssl=require, verify-ca, or verify-full). Leave unset in local mode.
# ORBIT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?ssl=require
# ORBIT_DATABASE_POOL_SIZE=5
# ORBIT_DATABASE_MAX_OVERFLOW=5

# Cloud mode only: Supabase Auth signs users in. Both values are public (they are sent to the
# browser); copy them from Project Settings > API Keys. Never set the service-role key here.
# The project must use asymmetric JWT signing keys (the default for new projects).
# ORBIT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# ORBIT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local mode: how long a sign-in lasts, in hours (default 336, i.e. 14 days).
# ORBIT_LOCAL_SESSION_TTL_HOURS=336
# Local mode: whether accounts beyond the first can register. Unset means open outside
# production (several people can share one machine) and first-account-only in production.
# ORBIT_LOCAL_OPEN_REGISTRATION=false

# Reminders: a worker delivers due reminders as in-app notifications. Unset runs it inside the
# API process (except in tests). Set to false if you run `orbit-worker` separately instead.
# ORBIT_SCHEDULER_IN_API=true
# How often a worker looks for due reminders, in seconds (1 to 300).
# ORBIT_SCHEDULER_POLL_SECONDS=15

# Note attachments and document files are stored as files, outside the database. Defaults to
# an `attachments` folder beside the SQLite database. Back it up together with the database.
# ORBIT_ATTACHMENTS_PATH=~/.local/share/orbit/attachments
# ORBIT_ATTACHMENT_MAX_BYTES=10485760
# ORBIT_DOCUMENT_MAX_BYTES=26214400

# Workspace backups (Settings -> Backup & restore) and staged uploads. Defaults to a `backups`
# folder beside the SQLite database. Keep copies of important backups somewhere else too.
# ORBIT_BACKUPS_PATH=~/.local/share/orbit/backups
# ORBIT_BACKUP_UPLOAD_MAX_BYTES=2147483648
# ORBIT_BACKUP_MAX_EXTRACTED_BYTES=21474836480

# AI: off until each person turns it on in Settings. This switches it off for everyone.
# ORBIT_AI_ENABLED=true
# A Fernet key that encrypts stored provider API keys. Unset in local mode, a key file is created
# beside the SQLite database; required in cloud mode to store keys.
# ORBIT_AI_SECRET_KEY=
# Allow provider endpoints on loopback or private addresses (unset: local mode yes, cloud no).
# ORBIT_AI_ALLOW_PRIVATE_ENDPOINTS=true
# How often the worker indexes records for semantic search, in seconds.
# ORBIT_AI_INDEX_INTERVAL_SECONDS=60

# Market data: each workspace opts in under Settings → Finance for automatic prices, fund search,
# and units worked out from a NAV. Set false to disable live prices globally. When enabled, only
# each holding's scheme code or ticker (never units or amounts) is sent to mfapi.in and Yahoo Finance.
# ORBIT_MARKET_DATA_ENABLED=false
# ORBIT_MARKET_DATA_REFRESH_HOURS=6

# Online maps for Places: each workspace opts in under Settings → Places. The browser then loads
# map tiles from the style URL, and place search sends only the search phrase to the geocoder
# (Nominatim's API). Set false to keep every workspace on the offline world map.
# ORBIT_ONLINE_MAPS_ENABLED=false
# ORBIT_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# ORBIT_GEOCODER_URL=https://nominatim.openstreetmap.org

# External integrations (see docs/integrations.md). A provider is offered only when its OAuth
# client ID is set. Client secrets are server-only; never put them in the web app's env.
# ORBIT_INTEGRATIONS_ENABLED=true
# ORBIT_GOOGLE_CLIENT_ID=
# ORBIT_GOOGLE_CLIENT_SECRET=
# ORBIT_MICROSOFT_CLIENT_ID=
# ORBIT_MICROSOFT_CLIENT_SECRET=
# ORBIT_MICROSOFT_TENANT=common
# The web app's callback page, registered exactly with each provider.
# ORBIT_INTEGRATIONS_REDIRECT_URL=http://localhost:3000/integrations/callback
# A Fernet key that encrypts access and refresh tokens. Unset in local mode, a key file is created
# beside the SQLite database; required in cloud mode to connect accounts.
# ORBIT_INTEGRATIONS_SECRET_KEY=
# Public HTTPS address of /api/v1/integrations/webhooks for push notifications; unset to poll.
# ORBIT_INTEGRATIONS_WEBHOOK_URL=https://orbit.example.com/api/v1/integrations/webhooks
# How often the worker looks for due synchronization work, in seconds.
# ORBIT_INTEGRATIONS_POLL_SECONDS=30
