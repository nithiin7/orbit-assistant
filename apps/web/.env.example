# Copy to apps/web/.env.local for local overrides. Never commit real values.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle and are
# PUBLIC. Never put secrets, API keys, or tokens in a NEXT_PUBLIC_ variable.

# Base URL of the Orbit API, as reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
